{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "#app/*": [
        "./src/app/*"
      ],
      "#features/*": [
        "./src/features/*"
      ],
      "#shared/*": [
        "./src/shared/*"
      ]
    },
    "checkJs": false,
    "allowJs": true
  },
  "include": [
    "src",
    "tests",
    "scripts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "inspironics"
  ]
}
